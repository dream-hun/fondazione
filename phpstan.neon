includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/

    level: max
    ignoreErrors:
        - '#Method App\\Models\\.*::.*\(\) return type with generic class Illuminate\\Database\\Eloquent\\Casts\\Attribute does not specify its types#'
